# Copy to .env and adjust. .env is gitignored.
# Every setting has a default (ingestion/config.py, or docker-compose.yml for the lakehouse);
# set a variable only to override it.

# Kafka API as seen from the host (inside the compose network it is redpanda:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081

# Lakehouse (make lakehouse): local development credentials for the object store.
# Read by docker-compose.yml, which uses these values when they are not set.
# S3_ACCESS_KEY_ID=wikipulse
# S3_SECRET_ACCESS_KEY=wikipulse-dev-secret
# The catalog (Lakekeeper): its Postgres password, and the key that encrypts the storage
# credentials it keeps in Postgres.
# CATALOG_DB_PASSWORD=lakekeeper-dev-password
# CATALOG_ENCRYPTION_KEY=wikipulse-dev-encryption-key

# RAW_TOPIC=wiki.raw
# DLQ_TOPIC=wiki.dlq
# Replays write to their own topics. They must differ from the two above.
# REPLAY_RAW_TOPIC=wiki.replay
# REPLAY_DLQ_TOPIC=wiki.replay.dlq
# LOG_LEVEL=INFO
