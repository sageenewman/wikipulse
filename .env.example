# Copy to .env and adjust. .env is gitignored.
# Every setting has a default in ingestion/config.py; set a variable only to override it.

# Kafka API as seen from the host (inside the compose network it is redpanda:9092)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:18081

# Lakehouse (make lakehouse). Local development credentials for the object store;
# docker-compose.yml and the scripts use these defaults when the variables are not set.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=wikipulse
# S3_SECRET_ACCESS_KEY=wikipulse-dev-secret
# ICEBERG_CATALOG_URI=http://localhost:8181

# RAW_TOPIC=wiki.raw
# DLQ_TOPIC=wiki.dlq
# Replays write to their own topics. They must differ from the two above.
# REPLAY_RAW_TOPIC=wiki.replay
# REPLAY_DLQ_TOPIC=wiki.replay.dlq
# LOG_LEVEL=INFO
